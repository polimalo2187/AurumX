{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "node": "20"
  },
  "steps": {
    "install": {
      "inputs": [
        { "step": "packages:mise" },
        { "local": true, "include": ["package.json", "package-lock.json", ".npmrc", ".nvmrc", ".node-version"] }
      ],
      "commands": [
        {
          "cmd": "pwd && ls -la && npm install --include=dev --no-audit --no-fund",
          "customName": "Install dependencies with dev tools"
        }
      ]
    },
    "build": {
      "inputs": [
        { "step": "install" },
        { "local": true, "include": ["."] }
      ],
      "commands": [
        {
          "cmd": "npm run build",
          "customName": "Build AurumX frontend"
        }
      ],
      "deployOutputs": ["."]
    }
  },
  "deploy": {
    "inputs": [
      { "step": "build", "include": ["."] }
    ],
    "startCommand": "npm run preview -- --host 0.0.0.0 --port $PORT"
  }
}
